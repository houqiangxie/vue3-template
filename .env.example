# 本地覆盖示例（复制为 .env.local / .env.dev.local 等，已在 .gitignore）
# 登录密码 AES（须与后端一致，均为 16 字节）。以下仅为占位，请换成真实密钥，勿提交真实值。
VITE_LOGIN_AES_KEY=your-16-byte-key!
VITE_LOGIN_AES_IV=your-16-byte-iv!!

# 可选：覆盖 Mock / 代理
# VITE_USE_MOCK=false
# VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# AI 对话流式接口（默认走 /api/ai/chat；可指向真实模型网关）
# VITE_AI_CHAT_URL=/api/ai/chat

# WebSocket 消息推送（支持 {token} 占位；设为 false 则仅 HTTP 轮询）
# VITE_WS_URL=wss://your-domain/ws?token={token}
# VITE_WS_URL=false

# 业务国际化（vue-i18n）；false 时不加载 vue-i18n，t() 使用代码中的中文 fallback
# VITE_ENABLE_I18N=true

# Electron 自动更新（打包后生效；开发环境默认不可用）
# ELECTRON_UPDATE_ENABLED=true
# ELECTRON_UPDATE_URL=https://your-update-server.example.com/releases
# ELECTRON_UPDATE_AUTO_DOWNLOAD=false
# ELECTRON_UPDATE_CHECK_ON_STARTUP=true
# ELECTRON_UPDATE_CHECK_INTERVAL_MS=14400000
