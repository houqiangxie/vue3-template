NODE_ENV = development
# 调接口/api 为了网关 没实际意义
VITE_baseUrl = '/api'
VITE_MODE = 'development'
VITE_BUILD_URL=/

# true=本地 Mock；false=代理真实接口（也可用 npm run dev:mock / dev:api 覆盖）
VITE_USE_MOCK=true
# 真实接口代理地址（VITE_USE_MOCK=false 时生效；本地可在 .env.dev.local 覆盖）
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# 登录 AES：须与后端一致；仅放 .env.dev.local，勿提交
# VITE_LOGIN_AES_KEY=
# VITE_LOGIN_AES_IV=
