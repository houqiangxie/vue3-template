{
  "name": "vue3-template",
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --mode dev",
    "dev:mock": "cross-env VITE_USE_MOCK=true vite --mode dev",
    "dev:api": "cross-env VITE_USE_MOCK=false vite --mode dev",
    "dev:web": "cross-env VITE_APPS=main vite --mode dev",
    "dev:app": "cross-env VITE_APPS=app vite --mode dev",
    "dev:bpm": "cross-env VITE_APPS=bpm vite --mode dev",
    "dev:electron": "cross-env ELECTRON=true vite --mode dev",
    "dev:i18n": "cross-env VITE_ENABLE_I18N=true vite --mode dev",
    "test": "echo \"No unit tests yet\" && exit 0",
    "build:test": "vite build --mode test",
    "prod": "vite build --mode prod",
    "build": "cross-env VITE_APPS=main,app,bpm vite build --mode build",
    "build:web": "cross-env VITE_APPS=main vite build --mode build",
    "build:app": "cross-env VITE_APPS=app vite build --mode build",
    "build:bpm": "cross-env VITE_APPS=bpm vite build --mode build",
    "build:electron": "cross-env ELECTRON=true vite build --mode build && node scripts/electron-build.mjs",
    "build:electron:dir": "cross-env ELECTRON=true vite build --mode build && node scripts/electron-build.mjs --dir",
    "electron:install": "node scripts/electron-install.mjs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "postinstall": "node scripts/electron-install.mjs && node scripts/generate-tray-icon.mjs"
  },
  "dependencies": {
    "@file-viewer/preset-office": "^2.2.3",
    "@file-viewer/vue3": "^2.2.3",
    "@vicons/antd": "^0.13.0",
    "@vicons/ionicons5": "^0.13.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "@wangeditor/plugin-mention": "1.0.0",
    "bpmn-js": "^17.9.2",
    "bpmn-js-properties-panel": "5.23.0",
    "bpmn-js-token-simulation": "^0.36.0",
    "camunda-bpmn-moddle": "^7.0.1",
    "dayjs": "^1.11.10",
    "diagram-js": "^12.8.0",
    "echarts": "^6.1.0",
    "electron-updater": "^6.6.2",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.12.0",
    "inherits": "^2.0.4",
    "lodash-es": "^4.18.1",
    "min-dash": "^4.1.1",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.4",
    "snabbdom": "3.5.1",
    "steady-xml": "^0.1.0",
    "ux-web-storage": "^1.0.6",
    "vant": "^4.10.0",
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.1.0",
    "vue-types": "^5.1.1",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@file-viewer/vite-plugin": "^2.2.3",
    "@types/file-saver": "^2.0.7",
    "@types/inherits": "^2.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "cross-env": "^10.0.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "eslint": "^10.6.0",
    "sass": "^1.101.0",
    "typescript": "^6.0.3",
    "unocss": "^66.7.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-electron": "^1.1.0",
    "vue-tsc": "^3.3.5"
  }
}
